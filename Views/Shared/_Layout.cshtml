<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Library App</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar">
        <div class="navbar-brand">
            <a asp-controller="Home" asp-action="Index">📚 LibraryApp</a>
        </div>
        <div class="navbar-links">
            <a asp-controller="Books" asp-action="Index">Books</a>
            @if (User.Identity!.IsAuthenticated)
            {
                if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="logout-btn">Logout</button>
                </form>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year LibraryApp. All rights reserved.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>